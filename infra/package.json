{
  "name": "infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false --noEmit",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never",
    "clean": "node -e \"require('fs').rmSync('cdk.out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "aws-cdk-lib": "2.269.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.13.4",
    "aws-cdk": "2.1141.0",
    "eslint": "9.35.0",
    "eslint-plugin-import-x": "4.16.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vitest": "3.2.7"
  }
}
